<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">Odisej</string>

    <string name="accessibility_description">Odisej watches only Instagram. To recognize the Reels screen it reads view IDs and class names — never text, messages or captions. It has no internet permission, so nothing can leave your phone. It stores nothing about your screen.</string>

    <!-- Glavni zaslon -->
    <string name="today">today</string>
    <string name="total">total: %1$d</string>
    <string name="status_active">Active</string>
    <string name="status_paused">Paused until %1$s</string>
    <string name="status_off">Service is off</string>
    <string name="btn_open_accessibility">Open accessibility settings</string>
    <string name="restricted_hint">Switch greyed out? Android 13+ blocks apps installed outside the Play Store. Try once, close the warning, then App info → ⋮ → Allow restricted settings.</string>
    <string name="btn_open_app_info">App info</string>

    <string name="mode_title">Moment of pause</string>
    <string name="mode_desc">Breathe for three seconds before deciding. Off: go back immediately.</string>
    <string name="dm_title">Allow reels from DMs</string>
    <string name="dm_desc">The reel someone sent you plays. The next one is blocked.</string>

    <string name="btn_pause">Pause for 15 minutes</string>
    <string name="btn_pause_cancel">Cancel</string>
    <string name="btn_resume">Resume now</string>
    <string name="pause_desc">Pausing takes a 60-second wait on this screen. Leave, and it starts over.</string>
    <plurals name="countdown_label">
        <item quantity="one">second</item>
        <item quantity="other">seconds</item>
    </plurals>
    <string name="privacy_line">No internet · Instagram only · never reads text</string>

    <!-- Back način -->
    <string name="toast_blocked">Reels are blocked — Odisej</string>

    <!-- Overlay -->
    <string name="overlay_inhale">breathe in</string>
    <string name="overlay_exhale">breathe out</string>
    <string name="overlay_still">Pause for a moment</string>
    <!-- Vrstilni števnik (#N), ne množina. -->
    <string name="overlay_sentence" tools:ignore="PluralsCandidate">That would have been reel #%1$d today.</string>
    <string name="overlay_btn_messages">Go to messages</string>
    <string name="overlay_btn_home">Go to feed</string>
    <string name="overlay_btn_close">Close Instagram</string>
</resources>
