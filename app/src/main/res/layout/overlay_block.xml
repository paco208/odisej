<?xml version="1.0" encoding="utf-8"?>
<!-- "Trenutek premora". En stolpec na 8dp mreži, vse horizontalno centrirano:
     - krog: središče na 40 % višine okna (BlockOverlay nastavi translationY ob vsakem layoutu),
     - napis vdih/izdih in nato stavek: 32dp pod okvirjem kroga (rob razširjenega kroga),
     - akcije: pritrjene na dno, vidni rob besedila 48dp nad navigacijsko vrstico.
     Razmiki pri akcijah so VIDNI (od roba besedila), dotikalna območja so 48dp:
     16sp besedilo je v 48dp gumbu ~14dp od roba, zato 2dp (= 16 vidno) in 34dp (= 48 vidno).
     Neprosojno ozadje je namen: reel za overlayem se ne sme videti. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/od_black"
    android:clickable="true"
    android:focusable="false"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/overlay_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <si.odisej.ui.BreathingCircleView
            android:id="@+id/overlay_circle"
            android:layout_width="224dp"
            android:layout_height="224dp" />

        <!-- En prostor za tri besedila: vdih → izdih → stavek (crossfade). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/overlay_label_a"
                style="@style/Odisej.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="@string/overlay_inhale" />

            <TextView
                android:id="@+id/overlay_label_b"
                style="@style/Odisej.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:gravity="center"
                tools:text="@string/overlay_exhale" />

            <TextView
                android:id="@+id/overlay_sentence"
                style="@style/Odisej.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:gravity="center"
                tools:text="To bi bil tvoj 3. reel danes." />
        </FrameLayout>
    </LinearLayout>

    <!-- Akcije: INVISIBLE do konca dihanja (ne tapneš refleksno). Spodnji odmik = 34dp + inset
         navigacije (BlockOverlay). -->
    <LinearLayout
        android:id="@+id/overlay_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Eksplicitno MaterialButton: v servisu ni AppCompat inflaterja (D32). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlay_btn_messages"
            style="@style/Odisej.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/overlay_btn_messages" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_btn_home"
                style="@style/Odisej.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/overlay_btn_home" />

            <TextView
                style="@style/Odisej.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/dot_separator"
                android:textColor="@color/od_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_btn_close"
                style="@style/Odisej.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/overlay_btn_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
