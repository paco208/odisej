<?xml version="1.0" encoding="utf-8"?>
<!-- "Trenutek premora": čisto črn zaslon, krog dihanja, nato stavek in gumba.
     Neprosojno ozadje je namen: reel za overlayem se ne sme videti. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/od_black"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    tools:ignore="Overdraw">

    <si.odisej.ui.BreathingCircleView
        android:id="@+id/overlay_circle"
        android:layout_width="220dp"
        android:layout_height="220dp" />

    <!-- Dva napisa drug na drugem za crossfade vdih → izdih. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">

        <TextView
            android:id="@+id/overlay_label_a"
            style="@style/Odisej.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="@string/overlay_inhale" />

        <TextView
            android:id="@+id/overlay_label_b"
            style="@style/Odisej.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:gravity="center"
            tools:text="@string/overlay_exhale" />
    </FrameLayout>

    <!-- INVISIBLE (ne GONE): prostor je rezerviran, krog med razkritjem ne skoči. -->
    <LinearLayout
        android:id="@+id/overlay_reveal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:alpha="0"
        android:orientation="vertical"
        android:visibility="invisible">

        <TextView
            android:id="@+id/overlay_sentence"
            style="@style/Odisej.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/od_text_secondary"
            tools:text="That was reel #3 today." />

        <Button
            android:id="@+id/overlay_btn_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/overlay_btn_messages" />

        <Button
            android:id="@+id/overlay_btn_home"
            style="@style/Odisej.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_btn_home" />
    </LinearLayout>
</LinearLayout>
