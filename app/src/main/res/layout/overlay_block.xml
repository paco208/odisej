<?xml version="1.0" encoding="utf-8"?>
<!-- "Trenutek premora". En vertikalni blok, horizontalno centriran, na 8dp mreži:
     krog → 32dp → stavek → 48dp → tri akcije (vrstice 56dp, ločila 240dp).
     Med dihanjem je središče kroga na 40 % višine; po dihanju se okvir kroga skrči
     (224 → 96dp), prostor za besedilo na višino stavka, in blok se v 300 ms poravna na
     45 % višine (BlockOverlay, OverlayLayout). Spodaj vedno vsaj 48dp do navigacije.
     Koren je nujen: dobi inseti in ozadje, stolpec se v njem premika s translationY.
     Neprosojno ozadje je namen: reel za overlayem se ne sme videti. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/od_black"
    android:clickable="true"
    android:focusable="false"
    tools:ignore="Overdraw,UselessParent">

    <LinearLayout
        android:id="@+id/overlay_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <si.odisej.ui.BreathingCircleView
            android:id="@+id/overlay_circle"
            android:layout_width="224dp"
            android:layout_height="224dp" />

        <!-- En prostor za tri besedila: vdih → izdih → stavek (crossfade). Napisa sta zgoraj
             poravnana, da ju krčenje prostora po dihanju odreže od spodaj, medtem ko izginjata. -->
        <FrameLayout
            android:id="@+id/overlay_text_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/overlay_label_a"
                style="@style/Odisej.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center"
                tools:text="@string/overlay_inhale" />

            <TextView
                android:id="@+id/overlay_label_b"
                style="@style/Odisej.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:alpha="0"
                android:gravity="center"
                tools:text="@string/overlay_exhale" />

            <TextView
                android:id="@+id/overlay_sentence"
                style="@style/Odisej.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:alpha="0"
                android:gravity="center"
                tools:text="To bi bil tvoj 3. reel danes." />
        </FrameLayout>

        <!-- Akcije: INVISIBLE do konca dihanja (ne tapneš refleksno), prostor je rezerviran.
             Navadni TextView-i (ne MaterialButton): brez obrob ali ozadij iz teme. -->
        <LinearLayout
            android:id="@+id/overlay_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:alpha="0"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="invisible">

            <TextView
                android:id="@+id/overlay_btn_messages"
                style="@style/Odisej.Text.Action"
                android:fontFamily="@font/odisej_medium"
                android:text="@string/overlay_btn_messages"
                android:textColor="@color/od_text" />

            <View style="@style/Odisej.Divider.Short" />

            <TextView
                android:id="@+id/overlay_btn_home"
                style="@style/Odisej.Text.Action"
                android:text="@string/overlay_btn_home" />

            <View style="@style/Odisej.Divider.Short" />

            <TextView
                android:id="@+id/overlay_btn_close"
                style="@style/Odisej.Text.Action"
                android:text="@string/overlay_btn_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
