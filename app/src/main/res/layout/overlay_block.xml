<?xml version="1.0" encoding="utf-8"?>
<!-- Neprosojno ozadje je namen: reel za overlayem se ne sme videti. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/overlay_title"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/overlay_body"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <Button
        android:id="@+id/overlay_btn_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/overlay_btn_messages" />

    <Button
        android:id="@+id/overlay_btn_home"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/overlay_btn_home" />
</LinearLayout>
